CACHE_THRESHOLD=0.97
SELF_CHECK_ENABLED=1
MODEL_CONTEXT=4096
MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT=300
TOOL_TIMEOUT=300
RERANKER_MODEL=BAAI/bge-reranker-base
